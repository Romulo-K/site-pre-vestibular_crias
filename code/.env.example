# modelo do arquivo .env
# copiar pra um arquivo chamado .env (na pasta code/) e preencher:  cp .env.example .env
# o .env NÃO vai pro github (tá no .gitignore)

# 1 = modo de teste no meu pc (mostra os erros). no servidor: 0
DEBUG=1

# chave secreta do django. no pc pode deixar vazio
# no servidor é obrigatória, pra gerar uma:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# endereço do site (só no servidor): prevestibularcrias.pythonanywhere.com
ALLOWED_HOSTS=

# 1 = mostra a faixa "Versão de teste" e o google não indexa. quando lançar: 0
SITE_EM_TESTE=1
