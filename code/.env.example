# =====================================================================
# Modelo do arquivo .env — copie para ".env" (na pasta code/) e ajuste.
#     cp .env.example .env
# O .env fica SÓ no seu computador (ou no servidor). Ele NUNCA vai para o GitHub.
# =====================================================================

# 1 = modo de desenvolvimento (mostra erros detalhados). No servidor: 0
DEBUG=1

# Chave secreta do Django. No seu computador pode ficar vazia (usa uma chave de teste).
# No servidor é obrigatória. Para gerar uma:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Endereços do site, separados por vírgula (no servidor). Ex.: precrias.pythonanywhere.com
ALLOWED_HOSTS=
